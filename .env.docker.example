# Optional: Override MongoDB URIs to connect to MongoDB Atlas or AWS DocumentDB
# If left blank or unset, Docker Compose automatically defaults to the internal containerized MongoDB.
# MONGO_AUTH_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/auth_db?retryWrites=true&w=majority
# MONGO_ACCOUNT_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/account_db?retryWrites=true&w=majority
# MONGO_TRANSACTION_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/transaction_db?retryWrites=true&w=majority
